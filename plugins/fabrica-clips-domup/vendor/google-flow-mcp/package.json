{
  "name": "google-flow-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Flow: create consistent AI characters, generate Veo 3.1 and Omni videos, build and export scenes, and manage the Flow agent from Claude, Cursor or any MCP client.",
  "type": "module",
  "bin": {
    "google-flow-mcp": "dist/index.js",
    "google-flow-mcp-login": "dist/login.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "google-flow",
    "veo",
    "veo3",
    "veo-3.1",
    "omni",
    "nano-banana",
    "ai-video",
    "text-to-video",
    "ai-filmmaking",
    "claude",
    "claude-code",
    "cursor",
    "playwright",
    "ai-agents",
    "consistent-characters"
  ],
  "author": "Muhammad Rohaan Atique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RohaanA/google-flow-mcp.git"
  },
  "homepage": "https://github.com/RohaanA/google-flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/RohaanA/google-flow-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PROTOCOL.md"
  ]
}
